---
layout: layouts/base.njk
title: Gallery — thehotelrightnow
eyebrow: Visual Narrative
description: Explore the architectural beauty and atmosphere of our spaces.
heroImage: /assets/img/gallery/our-craft.webp
---

{% include "components/page-hero.njk" %}

<style>
  .masonry-grid {
    column-count: 1;
    column-gap: var(--space-4);
    padding-block: var(--space-8);
  }
  @media (min-width: 640px) {
    .masonry-grid { column-count: 2; }
  }
  @media (min-width: 1024px) {
    .masonry-grid { column-count: 3; }
  }
  .masonry-item {
    break-inside: avoid;
    margin-bottom: var(--space-4);
    cursor: zoom-in;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
  }
  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--transition-base);
  }
  .masonry-item:hover img, .masonry-item:focus img {
    transform: scale(1.02);
  }

  /* Lightbox */
  #lightbox {
    padding: 0;
    border: none;
    background: rgba(23, 20, 15, 0.95);
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
  #lightbox::backdrop {
    background: rgba(23, 20, 15, 0.95);
  }
  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .lightbox-img-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    overflow: hidden;
  }
  .lightbox-img-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .lightbox-caption {
    color: var(--ivory);
    text-align: center;
    padding: var(--space-4);
    font-family: var(--font-sans);
  }
  .lightbox-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: transparent;
    border: none;
    color: var(--ivory);
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.5);
    border: none;
    color: white;
    font-size: 2rem;
    padding: var(--space-2);
    cursor: pointer;
  }
  .lightbox-prev { left: var(--space-4); }
  .lightbox-next { right: var(--space-4); }
</style>

<div class="container" style="padding-bottom: var(--space-16);">

  
  {% set allImages = [] %}
  {% for item in gallery.images %}{% set allImages = (allImages.push(item), allImages) %}{% endfor %}
  {% for item in dining.images %}{% set allImages = (allImages.push(item), allImages) %}{% endfor %}
  {% for item in events.images %}{% set allImages = (allImages.push(item), allImages) %}{% endfor %}
  {% for item in hotel.images %}{% set allImages = (allImages.push(item), allImages) %}{% endfor %}
  {% for item in rooms.images %}{% set allImages = (allImages.push(item), allImages) %}{% endfor %}

  <div class="masonry-grid" id="gallery-grid">
    {% for img in allImages %}
      <button class="masonry-item" aria-label="View {{ img.alt }}" data-index="{{ loop.index0 }}" data-src="{{ img.src }}" data-alt="{{ img.alt }}">
        <img src="{{ img.src }}" alt="{{ img.alt }}" width="{{ img.width }}" height="{{ img.height }}" {% if loop.index0 < 4 %}loading="eager"{% else %}loading="lazy"{% endif %}>
      </button>
    {% endfor %}
  </div>
</div>

<dialog id="lightbox">
  <div class="lightbox-content">
    <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
    <div class="lightbox-img-wrapper">
      <img id="lightbox-img" src="" alt="">
    </div>
    <div class="lightbox-caption" id="lightbox-caption"></div>
    <button class="lightbox-nav lightbox-prev" aria-label="Previous image">&#10094;</button>
    <button class="lightbox-nav lightbox-next" aria-label="Next image">&#10095;</button>
  </div>
</dialog>

<script>
  const galleryItems = document.querySelectorAll('.masonry-item');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = document.querySelector('.lightbox-close');
  const prevBtn = document.querySelector('.lightbox-prev');
  const nextBtn = document.querySelector('.lightbox-next');
  let currentIndex = 0;

  function updateLightbox(index) {
    if (index < 0) index = galleryItems.length - 1;
    if (index >= galleryItems.length) index = 0;
    currentIndex = index;
    const item = galleryItems[currentIndex];
    lightboxImg.src = item.dataset.src;
    lightboxImg.alt = item.dataset.alt;
    lightboxCaption.textContent = item.dataset.alt;
  }

  galleryItems.forEach((item, index) => {
    item.addEventListener('click', () => {
      updateLightbox(index);
      lightbox.showModal();
    });
  });

  closeBtn.addEventListener('click', () => lightbox.close());
  prevBtn.addEventListener('click', () => updateLightbox(currentIndex - 1));
  nextBtn.addEventListener('click', () => updateLightbox(currentIndex + 1));

  lightbox.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
    if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
  });
</script>
