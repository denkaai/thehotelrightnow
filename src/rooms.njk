---
layout: layouts/base.njk
title: Rooms & Suites
eyebrow: Living
description: Private accommodations designed with organic textures, timber craftsmanship, and calming architectural proportions.
heroImage: /assets/img/rooms/whatsapp-image-2026-09-28-at-11.35.36-am.webp
---

{% include "components/page-hero.njk" %}

<style>
  /* ─── Rooms alternating layout ─── */
  .rooms-section {
    padding-block: var(--space-8) var(--space-12);
  }

  .room-entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: var(--space-12);
    align-items: stretch;
  }

  .room-img-wrap {
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/3;
    min-width: 0; /* Fix grid overflow */
    order: -1; /* Mobile: Image always on top */
  }

  @media (min-width: 900px) {
    .room-entry {
      grid-template-columns: 40fr 60fr; /* Room 1: Text(40), Image(60) */
    }
    .room-entry.reverse {
      grid-template-columns: 60fr 40fr; /* Room 2: Image(60), Text(40) */
    }
    .room-img-wrap { 
      aspect-ratio: auto; 
      height: 100%; 
      order: 2; /* Desktop Room 1: Text first, Image second */
    }
    .room-text {
      order: 1;
    }
    .room-entry.reverse .room-img-wrap {
      order: 1; /* Desktop Room 2: Image first */
    }
    .room-entry.reverse .room-text {
      order: 2; /* Desktop Room 2: Text second */
    }
  }

  .room-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .room-entry:hover .room-img-wrap img {
    transform: scale(1.03);
  }

  .room-text {
    padding: var(--space-10) var(--space-10);
    background: var(--ivory);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0; /* Fix grid overflow */
  }

  @media (max-width: 899px) {
    .room-text {
      padding: var(--space-8) var(--space-6);
    }
  }

  /* ─── Room Typography & Variations ─── */
  .room-editorial-number {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-4);
  }
  .room-editorial-number .num {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
    color: var(--amber);
  }
  .room-editorial-number .label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--charcoal);
    margin-top: var(--space-1);
    opacity: 0.7;
  }

  .room-name {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    color: var(--charcoal);
    margin-bottom: var(--space-4);
  }

  .room-coming-soon {
    font-size: 0.875rem;
    color: #8a7c6e;
    font-style: italic;
    margin-bottom: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--amber);
    background: rgba(217, 164, 65, 0.06);
  }

  .room-description {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #4a3f35;
    margin-bottom: var(--space-6);
  }

  /* Room 1 Variations */
  .room-entry--1 .room-text {
    border-left: 4px solid var(--amber);
  }
  
  /* Room 2 Variations */
  .room-entry--2 .room-text {
    border-right: 4px solid var(--amber);
  }
  .room-entry--2 .room-img-wrap {
    aspect-ratio: 16/9; /* different crop on mobile */
  }
  @media (min-width: 900px) {
    .room-entry--2 .room-img-wrap {
      aspect-ratio: auto;
    }
  }

  /* Room 3 Variations */
  .room-entry--3 .room-text {
    background: #ede8df;
    padding: var(--space-12) var(--space-10);
  }

  /* Custom Reveal for Rooms */
  .js .room-entry.reveal {
    transform: translateY(20px);
    transition-duration: 0.6s;
  }
</style>

<div class="rooms-section">
  {% if rooms.rooms and rooms.rooms.length > 0 %}
    {% for room in rooms.rooms %}
      <div class="room-entry room-entry--{{ loop.index }}{% if loop.index is even %} reverse{% endif %} reveal reveal-stagger">

        <div class="room-text">
          <div class="room-editorial-number reveal">
            <span class="num">0{{ loop.index }}</span>
            <span class="label">ROOM</span>
          </div>

          {% if room.name and room.name != "CONTENT REQUIRED" %}
            <h2 class="room-name reveal">{{ room.name }}</h2>
          {% else %}
            <h2 class="room-name reveal">Room {{ loop.index }}</h2>
          {% endif %}

          <p class="room-coming-soon reveal">Room details coming soon — contact us directly for availability and rates.</p>

          {% if room.description and room.description != "CONTENT REQUIRED" %}
            <p class="room-description reveal">{{ room.description }}</p>
          {% endif %}

          <div class="reveal">
            <a href="/contact/#enquiry" class="btn btn-primary">Enquire About This Room</a>
          </div>
        </div>

        <div class="room-img-wrap reveal">
          <img
            src="{{ room.src }}"
            alt="{{ room.alt }}"
            width="{{ room.width }}"
            height="{{ room.height }}"
            loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
          >
        </div>

      </div>
    {% endfor %}
  {% else %}
    <div class="container" style="text-align: center; padding: var(--space-16) 0; max-width: 600px; margin: 0 auto;">
      <h2 style="font-family: var(--font-serif); font-size: 2.5rem; margin-bottom: var(--space-4);">Rooms coming soon</h2>
      <p style="margin-bottom: var(--space-8);">We are currently preparing our accommodation portfolio. Please contact us directly for availability.</p>
      <a href="/contact/#enquiry" class="btn btn-primary">Make an Enquiry</a>
    </div>
  {% endif %}
</div>
