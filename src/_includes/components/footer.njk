<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <h2 class="footer-logo">
        <img src="/assets/img/brand/logo-transparent-2400.webp" srcset="/assets/img/brand/logo-transparent-1200.webp 1200w, /assets/img/brand/logo-transparent-2400.webp 2400w" alt="thehotelrightnow logo" style="max-height: 56px; width: auto; display: block;">
      </h2>
      {% if site.address and site.address != 'CONTENT REQUIRED' %}
        <p class="footer-address">{{ site.address }}</p>
      {% endif %}
      <div class="footer-contact">
        {% if site.phone and site.phone != 'CONTENT REQUIRED' %}
          <p><a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a></p>
        {% endif %}
        {% if site.email and site.email != 'CONTENT REQUIRED' %}
          <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        {% endif %}
        {% if site.whatsapp and site.whatsapp != 'CONTENT REQUIRED' %}
          <p><a href="https://wa.me/{{ site.whatsapp | replace('+', '') | replace(' ', '') }}">WhatsApp</a></p>
        {% endif %}
      </div>
    </div>
    
    <div class="footer-nav-col">
      <nav aria-label="Footer Navigation">
        <ul class="footer-nav">
          <li><a href="/rooms/">Rooms &amp; Suites</a></li>
          <li><a href="/dining/">Dining</a></li>
          <li><a href="/events/">Events</a></li>
          <li><a href="/gallery/">Gallery</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
    
    <div class="footer-social">
      {% include "components/social-icons.njk" %}
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {{ site.displayName }}. All rights reserved.</p>
  </div>
</footer>
